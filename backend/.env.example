# Keep the real key only in backend/.env, never in Flutter or GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=1500
GEMINI_HISTORY_MESSAGE_LIMIT=20
